@startuml
' Diagramme de contexte — version simple.
' Règle : trois acteurs, un système, deux services externes. Aucune note.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  roundcorner 6
  ArrowColor #333333
  BackgroundColor white
  actorBorderColor #1B3A6B
  actorBackgroundColor #E8F0FE
  rectangleBorderColor #333333
  rectangleBackgroundColor #F7FBFF
  componentBorderColor #8A6D1F
  componentBackgroundColor #FEF9E7
  ranksep 70
}

title Contexte

left to right direction

actor "Rédacteur" as R
actor "Visiteur" as V
actor "Administrateur" as A

rectangle "Éditeur de documents partagé" as S

component "Amazon SES" as SES
component "Stockage S3" as S3

R --> S : édite, partage,\ncrée des liens
V --> S : réserve et télécharge
A --> S : supervise
S --> SES : notification de fin de quota
V ..> S3 : télécharge le PDF

@enduml
