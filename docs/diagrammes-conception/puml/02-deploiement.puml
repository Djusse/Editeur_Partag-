@startuml
' Déploiement AWS — figure du README. Version simple : aucun détail
' d'exploitation (IMDSv2, crédits CPU, rôle IAM) : ces points sont dans le
' README et infra/README-infra.md.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  roundcorner 6
  linetype ortho
  ArrowColor #333333
  BackgroundColor white
  nodesep 40
  ranksep 50
  Padding 8
  rectangleBackgroundColor white
  rectangleBorderColor #333333
  nodeBackgroundColor #F7FBFF
  nodeBorderColor #333333
  databaseBackgroundColor #E9F7EF
  databaseBorderColor #1E6B45
  storageBackgroundColor #E9F7EF
  storageBorderColor #1E6B45
  queueBackgroundColor #E9F7EF
  actorBackgroundColor #E8F0FE
  actorBorderColor #1B3A6B
}

title Déploiement AWS — région eu-north-1

actor "Navigateur" as B
actor "Charge k6" as LG

rectangle "AWS — eu-north-1" #F7FBFF {

  rectangle "Elastic IP" as EIP #FFF4E5

  node "EC2 — m7i-flex.large" as EC2 {
    rectangle "nginx\nstatique · cache /status\nproxy /api · /d · /ws" as NG #E8F0FE
    rectangle "Node.js\nFastify + ws + Yjs" as APP #E8F0FE
    rectangle "Worker PDF" as WK #E8F0FE
  }

  database "DynamoDB" as DDB
  storage "S3" as S3
  queue "SQS" as SQS
  rectangle "SES" as SES #FEF9E7
  rectangle "SSM\nsecrets" as SSM #FEF9E7
}

B --> EIP : HTTP / WS
LG --> EIP
EIP --> NG
NG --> APP : proxy
APP --> DDB
APP --> S3
APP --> SQS
APP --> SES
APP --> SSM
WK --> SQS
WK --> S3
WK --> DDB
B ..> S3 : PDF présigné

@enduml
