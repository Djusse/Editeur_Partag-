@startuml
' Flux d'écriture — version simple.
' Le détail des gardes (crédit en lecture préalable, blocage, idempotence,
' WRITE_FAILED) est dans docs/api.md §6 et docs/adr/002.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  ArrowColor #333333
  BackgroundColor white
  actorBorderColor #1B3A6B
  actorBackgroundColor #E8F0FE
  databaseBackgroundColor #E9F7EF
  databaseBorderColor #1E6B45
  sequence {
    ParticipantBorderColor #333333
    ParticipantBackgroundColor #E8F0FE
    LifeLineBorderColor #BBBBBB
    GroupBorderColor #333333
    GroupHeaderBackgroundColor #F7FBFF
  }
}

title Flux d'écriture groupée (C2, C4)

actor Rédacteur as R
participant "Application\nhub" as H
database DynamoDB as D
actor "Autres\nrédacteurs" as O

R -> H : update { opId, payload }
H -> H : mettre en file\n(un seul écrivain par document)
== toutes les 250 ms ==
H -> D : transaction\n(seq, journal, crédit, opIds)
alt crédit suffisant
  H --> R : ack { seq, creditRemaining }
  H --> O : update diffusée
else crédit épuisé ou bloqué
  H --> R : erreur CREDIT_EXHAUSTED / BLOCKED
end

@enduml
