@startuml
' Cas d'utilisation — version simple.
' Dix cas, trois acteurs, deux relations. Le détail des règles est dans
' docs/api.md.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  roundcorner 6
  ArrowColor #333333
  BackgroundColor white
  actorBorderColor #1B3A6B
  actorBackgroundColor #E8F0FE
  usecaseBorderColor #333333
  usecaseBackgroundColor #F7FBFF
  rectangleBorderColor #333333
  nodesep 30
  ranksep 50
}

title Cas d'utilisation

left to right direction

actor Rédacteur as R
actor Visiteur as V
actor Administrateur as A

rectangle "Éditeur de documents partagé" {
  usecase "S'identifier" as UC1
  usecase "Gérer ses documents" as UC2
  usecase "Éditer en collaboration" as UC3
  usecase "Partager un document" as UC6
  usecase "Gérer les versions" as UC7
  usecase "Créer un lien\nde N exemplaires" as UC8
  usecase "Consulter son crédit" as UC4

  usecase "Consulter l'état du lien" as UC9
  usecase "Réserver un exemplaire" as UC10
  usecase "Télécharger le PDF" as UC11

  usecase "Superviser" as UC12
}

R --> UC1
R --> UC2
R --> UC3
R --> UC6
R --> UC7
R --> UC8
R --> UC4

V --> UC9
V --> UC10
V --> UC11

A --> UC12

UC2 ..> UC1 : <<include>>
UC3 ..> UC4 : <<extend>>

@enduml
