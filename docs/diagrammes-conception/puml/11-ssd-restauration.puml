@startuml
' Séquence système — restauration. Version simple.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  ArrowColor #333333
  BackgroundColor white
  actorBorderColor #1B3A6B
  actorBackgroundColor #E8F0FE
  sequence {
    ParticipantBorderColor #333333
    ParticipantBackgroundColor #E8F0FE
    LifeLineBorderColor #BBBBBB
    GroupBorderColor #333333
    GroupHeaderBackgroundColor #F7FBFF
  }
}

title Séquence système — restaurer une version

actor Rédacteur as R
participant "Système" as S
actor "Autres\nrédacteurs" as O

R -> S : lister les versions
S --> R : liste (n, date, auteur)
R -> S : restaurer la version n
S -> S : sauvegarder le texte courant
S -> S : écrire un nouvel update\nde remplacement
S --> R : confirmation
S --> O : modification diffusée

@enduml
