@startuml
' Séquence système — écriture. Version simple.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  ArrowColor #333333
  BackgroundColor white
  actorBorderColor #1B3A6B
  actorBackgroundColor #E8F0FE
  sequence {
    ParticipantBorderColor #333333
    ParticipantBackgroundColor #E8F0FE
    LifeLineBorderColor #BBBBBB
    GroupBorderColor #333333
    GroupHeaderBackgroundColor #F7FBFF
  }
}

title Séquence système — éditer un document

actor Rédacteur as R
participant "Système" as S
actor "Autres\nrédacteurs" as O

R -> S : s'identifier (nom, e-mail)
S --> R : jeton de session
R -> S : ouvrir la connexion du document
S --> R : état courant, présence,\ncrédit restant
loop à chaque saisie
  R -> S : envoyer une modification
  alt crédit suffisant
    S --> R : acquittement
    S --> O : modification diffusée
  else crédit épuisé ou bloqué
    S --> R : refus
    R -> R : passer en lecture seule
  end
end

@enduml
