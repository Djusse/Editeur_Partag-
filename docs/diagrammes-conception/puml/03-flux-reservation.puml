@startuml
' Flux de réservation — version simple.
' Le détail (garde mémoire, transition EXHAUSTED, notification SES) est décrit
' dans docs/api.md §4.2. Ici : qui parle à qui, et quelles réponses.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  ArrowColor #333333
  BackgroundColor white
  actorBorderColor #1B3A6B
  actorBackgroundColor #E8F0FE
  databaseBackgroundColor #E9F7EF
  databaseBorderColor #1E6B45
  sequence {
    ParticipantBorderColor #333333
    ParticipantBackgroundColor #E8F0FE
    LifeLineBorderColor #BBBBBB
    GroupBorderColor #333333
    GroupHeaderBackgroundColor #F7FBFF
  }
}

title Flux de réservation d'un exemplaire (C1)

actor Visiteur as V
participant nginx as N
participant "Application" as A
database DynamoDB as D
participant "Worker PDF" as W
participant S3 as S

V -> N : POST /d/{token}/claim { visitorId }
N -> A : proxy
A -> D : lire le lien, réserver\n(transaction conditionnelle)
alt exemplaire disponible
  A -> D : PDF en cache pour ce seq ?
  alt PDF absent
    A -> W : demande de génération
    A --> V : 202 « patienter »
    W -> S : dépose le PDF
  else PDF présent
    A --> V : 200 { url présignée }
  end
else lien épuisé
  A --> V : 410 « épuisé »
end
V -> S : GET sur l'URL présignée
S --> V : le PDF

@enduml
