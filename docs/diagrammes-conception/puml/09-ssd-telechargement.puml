@startuml
' Séquence système — téléchargement. Version simple.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  ArrowColor #333333
  BackgroundColor white
  actorBorderColor #1B3A6B
  actorBackgroundColor #E8F0FE
  sequence {
    ParticipantBorderColor #333333
    ParticipantBackgroundColor #E8F0FE
    LifeLineBorderColor #BBBBBB
    GroupBorderColor #333333
    GroupHeaderBackgroundColor #F7FBFF
  }
}

title Séquence système — réserver et télécharger

actor Visiteur as V
participant "Système" as S
participant "S3" as S3

V -> S : consulter l'état du lien
S --> V : actif ou épuisé, titre
V -> S : réserver (claim)
alt exemplaire disponible
  S --> V : « patienter » puis « prêt »
  V -> S3 : GET sur l'URL présignée
  S3 --> V : le PDF figé à la réservation
else épuisé
  S --> V : « épuisé »
end

@enduml
