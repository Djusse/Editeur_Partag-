@startuml
' Diagramme de classes — version simple.
' Champs réduits à la clé et à ce qui porte une règle. Les colonnes complètes
' sont dans backend/src/lib/types.ts, qui fait foi.

skinparam {
  dpi 150
  defaultFontName Arial
  shadowing false
  roundcorner 4
  classAttributeIconSize 0
  classBackgroundColor #FFFFFF
  classBorderColor #333333
  classArrowColor #333333
  ArrowThickness 1.1
  nodesep 40
  ranksep 55
  BackgroundColor white
}

title Modèle de données

hide empty members
hide circle

class Utilisateur {
  email
  nom
}

class Document {
  docId
  titre
  seq
}

class Membre {
  role
}

class MiseAJour {
  seq
  payload Yjs
  chars
}

class OpId {
  id
  hash
}

class Version {
  n (= seq)
}

class LienTelechargement {
  token
  maxDownloads
  remaining
  status
}

class Ticket {
  visitorId
  seqFrozen
}

class PdfCache {
  id
  status
}

class Credit {
  email + jour
  used
}

class Abus {
  email + jour
  refusals
  blockedUntil
}

Utilisateur "1" -- "0..*" Membre
Document "1" -- "1..*" Membre : partagé à
Document "1" *-- "0..*" MiseAJour : journal
Document "1" *-- "0..*" Version : historique
Document "1" -- "0..*" LienTelechargement : distribué par
LienTelechargement "1" *-- "0..*" Ticket : réserve
Ticket "0..*" -- "0..1" PdfCache : fige sur seq
MiseAJour "1" -- "0..*" OpId : idempotence
MiseAJour ..> Credit : débite
Abus ..> Credit : bloque après 4 refus

@enduml
