{
  "name": "editeur-partage-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Bibliothèques pures et handlers Lambda de l'éditeur de documents partagé",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "esbuild src/handlers/*.ts --bundle --platform=node --target=node20 --format=cjs --external:@aws-sdk/* --outdir=dist/handlers"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "lib0": "^0.2.98",
    "pdf-lib": "^1.17.1",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^20.17.6",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yjs": "^13.6.20"
  }
}
