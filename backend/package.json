{
  "name": "editeur-partage-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Serveur applicatif : Fastify (REST) + ws (WebSocket) + Yjs, worker PDF SQS",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server/main.ts src/server/worker.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outdir=dist/server --out-extension:.js=.mjs",
    "start": "node dist/server/main.mjs",
    "dev": "tsx watch src/server/main.ts",
    "worker": "node dist/server/worker.mjs",
    "worker:dev": "tsx src/server/worker.ts",
    "local": "tsx src/local/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "lib0": "^0.2.98",
    "pdfkit": "^0.15.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
